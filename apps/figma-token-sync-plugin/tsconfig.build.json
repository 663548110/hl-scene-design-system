{
  "compilerOptions": {
    "target": "ES5",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2017", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["@figma/plugin-typings"],
    "rootDir": "src",
    "outDir": ".build-tmp",
    "declaration": false,
    "sourceMap": false,
    "downlevelIteration": true
  },
  "include": ["src/**/*.ts"]
}
